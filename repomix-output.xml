<file path="supabase/functions/mitienda-register-promotion/index.ts">
import { createClient } from 'npm:@supabase/supabase-js@2';

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
  'Access-Control-Allow-Methods': 'POST, OPTIONS'
};

interface RegistrationInput {
  promoCode: string;
  fullName: string;
  storeName: string;
  pinHash: string;
  planCode: string;
  durationMonths: number;
}

interface RegistrationRow {
  id: string;
  user_id: string;
  product_id: string;
  plan_code: string;
  duration_months: number;
  full_name: string;
  store_name: string;
  status: string;
  promo_days: number;
  pin_hash: string | null;
  remote_user_id: string | null;
  remote_store_id: string | null;
}

interface ProvisionedStore {
  tienda_id: string;
  fecha_vencimiento: string;
  dia_corte_ancla: number;
}

function jsonResponse(status: number, body: unknown) {
  return new Response(JSON.stringify(body), {
    status,
    headers: { ...corsHeaders, 'Content-Type': 'application/json' }
  });
}

function isRegistrationInput(value: unknown): value is RegistrationInput {
  if (!value || typeof value !== 'object') return false;
  const input = value as Record<string, unknown>;
  return typeof input.promoCode === 'string'
    && typeof input.fullName === 'string'
    && typeof input.storeName === 'string'
    && typeof input.pinHash === 'string'
    && typeof input.planCode === 'string'
    && typeof input.durationMonths === 'number';
}

Deno.serve(async request => {
  if (request.method === 'OPTIONS') return new Response('ok', { headers: corsHeaders });
  if (request.method !== 'POST') return jsonResponse(405, { error: 'Método no permitido.' });

  const masterUrl = Deno.env.get('SUPABASE_URL');
  const masterAnonKey = Deno.env.get('SUPABASE_ANON_KEY');
  const masterServiceKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY');
  const tiendaUrl = Deno.env.get('MITIENDA_SUPABASE_URL');
  const tiendaAnonKey = Deno.env.get('MITIENDA_SUPABASE_ANON_KEY');
  const tiendaServiceKey = Deno.env.get('MITIENDA_SERVICE_ROLE_KEY');

  if (!masterUrl || !masterAnonKey || !masterServiceKey || !tiendaUrl || !tiendaAnonKey || !tiendaServiceKey) {
    console.error('Faltan secretos para la provisión Master–MiTienda.');
    return jsonResponse(500, { error: 'La activación promocional no está configurada en el servidor.' });
  }

  const authorization = request.headers.get('Authorization');
  if (!authorization) return jsonResponse(401, { error: 'Inicia sesión antes de activar la promoción.' });

  const userClient = createClient(masterUrl, masterAnonKey, {
    global: { headers: { Authorization: authorization } },
    auth: { persistSession: false, autoRefreshToken: false }
  });
  const { data: userData, error: userError } = await userClient.auth.getUser();
  if (userError || !userData.user || !userData.user.email) {
    return jsonResponse(401, { error: 'La sesión no es válida. Inicia sesión de nuevo.' });
  }

  const masterAdmin = createClient(masterUrl, masterServiceKey, {
    auth: { persistSession: false, autoRefreshToken: false }
  });
  const { data: authRecord, error: authRecordError } = await masterAdmin.auth.admin.getUserById(userData.user.id);
  if (authRecordError || !authRecord.user) {
    console.error('No se pudo validar la cuenta Master:', authRecordError?.message ?? 'usuario no encontrado');
    return jsonResponse(502, { error: 'No se pudo validar la cuenta para activar la promoción.' });
  }
  if (!authRecord.user.email_confirmed_at && !authRecord.user.confirmed_at) {
    return jsonResponse(403, { error: 'Confirma tu correo antes de activar la tienda.' });
  }

  let registrationId: string | null = null;
  let promoDays: number | null = null;

  try {
    const body = await request.json() as { password?: unknown; registration?: unknown; registrationId?: unknown };
    if (typeof body.password !== 'string' || body.password.length < 8 || body.password.length > 128) {
      return jsonResponse(400, { error: 'La contraseña no es válida para completar la activación.' });
    }

    if (body.registration !== undefined) {
      if (!isRegistrationInput(body.registration)) {
        return jsonResponse(400, { error: 'Los datos del paquete promocional no son válidos.' });
      }

      const { data: newRegistrationId, error: registrationError } = await masterAdmin.rpc(
        'create_customer_promo_registration',
        {
          p_user_id: userData.user.id,
          p_promo_code: body.registration.promoCode,
          p_full_name: body.registration.fullName,
          p_store_name: body.registration.storeName,
          p_pin_hash: body.registration.pinHash,
          p_plan_code: body.registration.planCode,
          p_duration_months: body.registration.durationMonths
        }
      );

      if (registrationError || typeof newRegistrationId !== 'string') {
        console.error('No se pudo crear el registro promocional:', registrationError?.message ?? 'respuesta inválida');
        return jsonResponse(400, { error: 'El código promocional no es válido o ya fue utilizado. Revisa el código e intenta de nuevo.' });
      }
      registrationId = newRegistrationId;
    } else if (typeof body.registrationId === 'string') {
      registrationId = body.registrationId;
    } else if (typeof userData.user.app_metadata.pending_registration_id === 'string') {
      registrationId = userData.user.app_metadata.pending_registration_id;
    }

    if (!registrationId) {
      return jsonResponse(404, { error: 'No hay una activación promocional pendiente para esta cuenta.' });
    }

    const { data: registrationData, error: registrationLoadError } = await masterAdmin
      .from('subscription_registrations')
      .select('id, user_id, product_id, plan_code, duration_months, full_name, store_name, status, promo_days, pin_hash, remote_user_id, remote_store_id')
      .eq('id', registrationId)
      .eq('user_id', userData.user.id)
      .maybeSingle();

    if (registrationLoadError || !registrationData) {
      console.error('No se pudo cargar el registro promocional:', registrationLoadError?.message ?? 'no encontrado');
      return jsonResponse(404, { error: 'No se encontró la solicitud de activación para esta cuenta.' });
    }

    const registration = registrationData as RegistrationRow;
    promoDays = registration.promo_days;
    if (registration.status === 'trial_active' && registration.remote_store_id) {
      const { data: existingSubscription, error: existingSubscriptionError } = await masterAdmin
        .from('suscripciones_clientes')
        .select('fecha_vencimiento')
        .eq('user_id', userData.user.id)
        .eq('tienda_remota_id', registration.remote_store_id)
        .maybeSingle();

      if (existingSubscriptionError) throw new Error('No se pudo consultar la suscripción que ya está activa.');
      return jsonResponse(200, {
        registrationId,
        status: 'trial_active',
        promoDays: registration.promo_days,
        expiresAt: existingSubscription?.fecha_vencimiento ?? null
      });
    }

    if (!['provisioning', 'failed'].includes(registration.status) || !registration.pin_hash) {
      return jsonResponse(409, { error: 'La solicitud no está lista para activarse. Contacta soporte.' });
    }

    const tiendaAdmin = createClient(tiendaUrl, tiendaServiceKey, {
      auth: { persistSession: false, autoRefreshToken: false }
    });
    const tiendaAuth = createClient(tiendaUrl, tiendaAnonKey, {
      auth: { persistSession: false, autoRefreshToken: false }
    });

    let remoteUserId = registration.remote_user_id;
    if (!remoteUserId) {
      const { data: linkedSubscription, error: linkedSubscriptionError } = await masterAdmin
        .from('suscripciones_clientes')
        .select('remote_user_id')
        .eq('user_id', userData.user.id)
        .eq('producto', 'STOCKIA')
        .not('remote_user_id', 'is', null)
        .limit(1)
        .maybeSingle();

      if (linkedSubscriptionError) {
        throw new Error('No se pudo consultar la vinculación de las cuentas.');
      }
      remoteUserId = linkedSubscription?.remote_user_id ?? null;
    }

    if (!remoteUserId) {
      const { data: existingRemoteSession } = await tiendaAuth.auth.signInWithPassword({
        email: userData.user.email,
        password: body.password
      });

      if (existingRemoteSession.user) {
        remoteUserId = existingRemoteSession.user.id;
      } else {
        const { data: createdRemoteUser, error: createRemoteUserError } = await tiendaAdmin.auth.admin.createUser({
          email: userData.user.email,
          password: body.password,
          email_confirm: true,
          user_metadata: { full_name: registration.full_name }
        });

        if (createRemoteUserError || !createdRemoteUser.user) {
          const { data: retryRemoteSession } = await tiendaAuth.auth.signInWithPassword({
            email: userData.user.email,
            password: body.password
          });
          if (retryRemoteSession.user) {
            remoteUserId = retryRemoteSession.user.id;
          } else {
            console.error('No se pudo crear o vincular Auth en MiTienda:', createRemoteUserError?.message ?? 'usuario no encontrado');
            return jsonResponse(409, {
              error: 'Ya existe una cuenta de MiTienda con ese correo y no se pudo validar su contraseña. Inicia sesión con la contraseña de MiTienda o solicita ayuda a soporte.'
            });
          }
        } else {
          remoteUserId = createdRemoteUser.user.id;
        }
      }
    }

    let remoteStoreId = registration.remote_store_id;
    let expirationDate: string | null = null;
    let anchorDay: number | null = null;

    if (!remoteStoreId) {
      const { data: provisionData, error: provisionError } = await tiendaAdmin.rpc(
        'puente_provisionar_tienda_catalogo',
        {
          p_registro_catalogo_id: registrationId,
          p_usuario_id: remoteUserId,
          p_email_dueno: userData.user.email,
          p_nombre_dueno: registration.full_name,
          p_nombre_tienda: registration.store_name,
          p_pin_hash: registration.pin_hash,
          p_plan_id: registration.plan_code,
          p_dias_prueba_gratis: registration.promo_days
        }
      );

      if (provisionError) throw new Error('No se pudo crear la tienda en MiTienda.');
      const provisioned = Array.isArray(provisionData) ? provisionData[0] as ProvisionedStore | undefined : undefined;
      if (!provisioned?.tienda_id || !provisioned.fecha_vencimiento || !provisioned.dia_corte_ancla) {
        throw new Error('MiTienda devolvió datos incompletos al crear la tienda.');
      }

      remoteStoreId = provisioned.tienda_id;
      expirationDate = provisioned.fecha_vencimiento;
      anchorDay = provisioned.dia_corte_ancla;
      const { error: saveRemoteIdsError } = await masterAdmin
        .from('subscription_registrations')
        .update({ remote_user_id: remoteUserId, remote_store_id: remoteStoreId, status: 'provisioning' })
        .eq('id', registrationId)
        .eq('user_id', userData.user.id);
      if (saveRemoteIdsError) throw new Error('La tienda se creó, pero no se pudo guardar su vínculo en Master.');
    }

    const { data: remoteStore, error: remoteStoreError } = await tiendaAdmin
      .from('tiendas')
      .select('fecha_vencimiento, dia_corte_ancla')
      .eq('id', remoteStoreId)
      .maybeSingle();
    if (remoteStoreError || !remoteStore) {
      throw new Error('No se pudo verificar la fecha de vencimiento de la tienda.');
    }
    expirationDate = expirationDate ?? remoteStore.fecha_vencimiento;
    anchorDay = anchorDay ?? remoteStore.dia_corte_ancla;

    const { error: masterSubscriptionError } = await masterAdmin
      .from('suscripciones_clientes')
      .upsert({
        user_id: userData.user.id,
        remote_user_id: remoteUserId,
        email_cliente: userData.user.email,
        nombre_tienda: registration.store_name,
        producto: 'STOCKIA',
        tienda_remota_id: remoteStoreId,
        plan_codigo: registration.plan_code,
        meses_contratados: 0,
        dia_corte_ancla: anchorDay,
        metodo_pago: 'PRUEBA_GRATIS',
        estado: 'PRUEBA_GRATIS',
        es_prueba_gratis: true,
        fecha_vencimiento: expirationDate
      }, { onConflict: 'producto,tienda_remota_id' });

    if (masterSubscriptionError) throw new Error('La tienda se activó, pero no se pudo guardar su suscripción en Master.');

    const { error: completeRegistrationError } = await masterAdmin
      .from('subscription_registrations')
      .update({
        remote_user_id: remoteUserId,
        remote_store_id: remoteStoreId,
        status: 'trial_active',
        pin_hash: null,
        provisioning_error: null
      })
      .eq('id', registrationId)
      .eq('user_id', userData.user.id);
    if (completeRegistrationError) throw new Error('La suscripción se creó, pero no se pudo cerrar el registro promocional.');

    const { error: metadataError } = await masterAdmin.auth.admin.updateUserById(userData.user.id, {
      app_metadata: {
        ...authRecord.user.app_metadata,
        registration_status: 'trial_active',
        pending_registration_id: null,
        product_id: 'stockia',
        plan_code: registration.plan_code
      }
    });
    if (metadataError) {
      console.error('No se pudo actualizar el estado de la cuenta después de activar la prueba:', metadataError.message);
    }

    return jsonResponse(200, {
      registrationId,
      storeId: remoteStoreId,
      status: 'trial_active',
      promoDays: registration.promo_days,
      expiresAt: expirationDate
    });
  } catch (error) {
    const message = error instanceof Error ? error.message : 'Error desconocido durante la activación.';
    console.error('Error en mitienda-register-promotion:', message);

    if (registrationId) {
      if (promoDays === null) {
        const { data: savedRegistration, error: savedRegistrationError } = await masterAdmin
          .from('subscription_registrations')
          .select('promo_days')
          .eq('id', registrationId)
          .eq('user_id', userData.user.id)
          .maybeSingle();
        if (savedRegistrationError) console.error('No se pudo recuperar la duración promocional:', savedRegistrationError.message);
        promoDays = savedRegistration?.promo_days ?? null;
      }

      const { error: stateError } = await masterAdmin
        .from('subscription_registrations')
        .update({ status: 'failed', provisioning_error: message })
        .eq('id', registrationId)
        .eq('user_id', userData.user.id)
        .neq('status', 'trial_active');
      if (stateError) console.error('No se pudo guardar el error de provisión:', stateError.message);
      return jsonResponse(202, {
        registrationId,
        status: 'failed',
        promoDays,
        error: 'La cuenta se creó, pero no se pudo terminar de activar MiTienda. Inicia sesión de nuevo para reintentar o contacta soporte.'
      });
    }

    return jsonResponse(502, {
      error: 'No se pudo procesar la activación promocional.'
    });
  }
});
