// src/views/Account.tsx
import { useEffect } from 'react';
import { useNavigate, Link } from 'react-router-dom';
import { useAppContext } from '../context/AppContext';
import { products } from '../data/products';
import { Badge, Button } from '../components/UI';
import { ic } from '../utils/icons';
import { useReveal } from '../hooks/useReveal';

export const Account = () => {
  const { loggedIn, user, subs, invoices, logout, addToast } = useAppContext();
  const navigate = useNavigate();
  useReveal();

  useEffect(() => {
    if (!loggedIn) {
      addToast('Debes iniciar sesión para ver tu cuenta', 'warn');
      navigate('/');
    }
  }, [loggedIn, navigate, addToast]);

  if (!loggedIn || !user) return null;

  const handleProx = () => addToast('Próximamente disponible', 'warn');

  return (
    <div className="container" style={{ paddingTop: 40, paddingBottom: 80 }}>
      <div className="flex flex-wrap items-start justify-between gap-6" style={{ marginBottom: 48 }}>
        <div>
          <Link to="/" style={{ color: 'var(--mut)', display: 'inline-flex', alignItems: 'center', gap: 8, marginBottom: 24 }}>
            {ic('arrowL', 16)} Volver al inicio
          </Link>
          <div className="flex items-center gap-4 sm:gap-5">
            <div style={{ width: 56, height: 56, borderRadius: '50%', background: 'var(--accent)', color: '#fff', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 20, fontWeight: 700 }}>
              {user.initials}
            </div>
            <div>
              <h1 style={{ fontSize: '2rem', margin: 0 }}>Hola, {user.name.split(' ')[0]}</h1>
              <p style={{ color: 'var(--mut)' }}>{user.email} · {user.plan}</p>
            </div>
          </div>
        </div>
        <div style={{ display: 'flex', gap: '16px' }}>
          <Button variant="glass" onClick={logout}>{ic('logout', 16)} Cerrar sesión</Button>
        </div>
      </div>

      {/* Summary Cards */}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(min(100%, 200px), 1fr))', gap: 20, marginBottom: 48 }}>
        {[
          { i: 'shield', l: 'Plan de cuenta', v: user.plan },
          { i: 'box', l: 'Productos activos', v: `${subs.length} de ${products.length}` },
          { i: 'calendar', l: 'Próxima renovación', v: '30 nov 2025' },
          { i: 'creditCard', l: 'Consumo mensual', v: '$112.00' }
        ].map((c, i) => (
          <div key={i} className="glass reveal" style={{ padding: 20, borderRadius: 16, display: 'flex', gap: 16, alignItems: 'center' }}>
            <div style={{ color: 'var(--accent)' }}>{ic(c.i as any, 24)}</div>
            <div>
              <div style={{ fontSize: 13, color: 'var(--mut)' }}>{c.l}</div>
              <div style={{ fontWeight: 600, fontSize: 16 }}>{c.v}</div>
            </div>
          </div>
        ))}
      </div>

      {/* Subscriptions */}
      <h2 style={{ fontSize: '1.8rem', marginBottom: 24 }}>Productos contratados</h2>
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(min(100%, 450px), 1fr))', gap: 24, marginBottom: 64 }}>
        {subs.map((s, i) => {
          const p = products.find(x => x.id === s.pid)!;
          return (
            <div key={i} className="glass reveal" style={{ borderRadius: 20, overflow: 'hidden' }}>
              <div style={{ padding: 24, borderBottom: '1px solid var(--line)' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 16 }}>
                  <div style={{ display: 'flex', gap: 16, alignItems: 'center' }}>
                    <Badge text={p.badge} color={p.color} />
                    <div>
                      <div style={{ fontWeight: 700, fontSize: 18 }}>{p.name}</div>
                      <div style={{ fontSize: 13, color: 'var(--mut)' }}>{p.tag}</div>
                    </div>
                  </div>
                  <div style={{ background: 'rgba(11,122,80,0.1)', color: 'var(--ok)', padding: '4px 12px', borderRadius: 999, fontSize: 12, fontWeight: 600 }}>Activo</div>
                </div>
                <div style={{ fontSize: 13, color: 'var(--mut)', marginBottom: 8 }}>Uso de licencias: {s.users} ({s.upct}%)</div>
                <div style={{ height: 4, background: 'rgba(0,0,0,0.05)', borderRadius: 2, overflow: 'hidden' }}>
                  <div style={{ width: `${s.upct}%`, height: '100%', background: p.color }} />
                </div>
              </div>
              <div style={{ padding: 24, background: 'rgba(255,255,255,0.3)', display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(120px, 1fr))', gap: 16, fontSize: 13 }}>
                <div><div style={{ color: 'var(--mut)' }}>ID Suscripción</div><div style={{ fontWeight: 500 }}>{s.sid}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Versión</div><div style={{ fontWeight: 500 }}>v{s.ver}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Renovación</div><div style={{ fontWeight: 500 }}>{s.renewal}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Uptime</div><div style={{ fontWeight: 500 }}>{s.uptime}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Llamadas API</div><div style={{ fontWeight: 500 }}>{s.api}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Último backup</div><div style={{ fontWeight: 500 }}>{s.backup}</div></div>
              </div>
              <div style={{ padding: 16, borderTop: '1px solid var(--line)', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <div style={{ fontSize: 13, color: 'var(--mut)' }}>{s.plan} · Cliente desde {s.since}</div>
                <Button variant="dark" to={`/producto/${p.id}`}>Abrir producto →</Button>
              </div>
            </div>
          );
        })}
      </div>

      {/* Invoices */}
      <h2 style={{ fontSize: '1.8rem', marginBottom: 24 }}>Facturación reciente</h2>
      <div className="glass reveal" style={{ borderRadius: 16, overflowX: 'auto', marginBottom: 64 }}>
        <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left' }}>
          <thead style={{ background: 'rgba(0,0,0,0.03)' }}>
            <tr>
              <th style={{ padding: '16px 24px', fontWeight: 600, fontSize: 14 }}>Fecha</th>
              <th style={{ padding: '16px 24px', fontWeight: 600, fontSize: 14 }}>Concepto</th>
              <th style={{ padding: '16px 24px', fontWeight: 600, fontSize: 14 }}>Estado</th>
              <th style={{ padding: '16px 24px', fontWeight: 600, fontSize: 14, textAlign: 'right' }}>Importe</th>
              <th style={{ padding: '16px 24px' }}></th>
            </tr>
          </thead>
          <tbody>
            {invoices.map((inv, i) => (
              <tr key={i} style={{ borderTop: '1px solid var(--line)' }}>
                <td style={{ padding: '16px 24px', fontSize: 14 }}>{inv.date}</td>
                <td style={{ padding: '16px 24px', fontSize: 14 }}>{inv.concept}</td>
                <td style={{ padding: '16px 24px' }}><span style={{ background: 'rgba(11,122,80,0.1)', color: 'var(--ok)', padding: '2px 8px', borderRadius: 4, fontSize: 12 }}>{inv.status}</span></td>
                <td style={{ padding: '16px 24px', fontSize: 14, fontWeight: 600, textAlign: 'right' }}>{inv.amount}</td>
                <td style={{ padding: '16px 24px', textAlign: 'right' }}><button onClick={handleProx} style={{ color: 'var(--mut)' }}>{ic('download', 18)}</button></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
};
</file>

<file path="src/views/Home.tsx">
import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { products, platformSlide } from '../data/products';
import { useAppContext } from '../context/AppContext';
import { Brand, Badge, Button } from '../components/UI';
import { SessionButton } from '../components/SessionButton';
import { ic } from '../utils/icons';
import { useReveal } from '../hooks/useReveal';
import { Modal } from '../components/Modal';
import type { Product } from '../types';

const slideProgressColors: Record<Product['id'], string> = {
  stockia: 'bg-[#0e9f6e]',
  citalis: 'bg-[#2f9ec4]',
  turnia: 'bg-[#d97b29]',
  mesa: 'bg-[#8a5cd6]'
};

const productTextColors: Record<Product['id'], string> = {
  stockia: 'text-[#0e9f6e]',
  citalis: 'text-[#2f9ec4]',
  turnia: 'text-[#d97b29]',
  mesa: 'text-[#8a5cd6]'
};

const revealDelays = ['delay-0', 'delay-75', 'delay-150', 'delay-[225ms]'];

export const Home = () => {
  useReveal();
  const navigate = useNavigate();
  const { addToast } = useAppContext();
  const [activeIndex, setActiveIndex] = useState(0);
  const [isHovering, setIsHovering] = useState(false);
  const [showCallModal, setShowCallModal] = useState(false);

  const slides = [platformSlide, ...products];

  useEffect(() => {
    if (isHovering) return;
    const timer = setInterval(() => {
      setActiveIndex(prev => (prev + 1) % slides.length);
    }, 5200);
    return () => clearInterval(timer);
  }, [isHovering, slides.length]);

  const handleCardClick = (idx: number) => {
    const slide = slides[idx];
    if (slide.id === 'plat') {
      document.getElementById('productos')?.scrollIntoView({ behavior: 'smooth' });
    } else if (slide.enabled) {
      navigate(`/producto/${slide.id}`);
    } else {
      addToast('Disponible próximamente', 'warn');
    }
  };

  return (
    <div>
      <section
        className="relative flex min-h-[min(900px,100svh)] flex-col overflow-hidden md:min-h-[760px]"
        onMouseEnter={() => setIsHovering(true)}
        onMouseLeave={() => setIsHovering(false)}
      >
        {slides.map((slide, i) => (
          <div
            key={slide.id}
            className={`absolute inset-0 z-0 transition-opacity duration-1000 ease-in-out ${activeIndex === i ? 'opacity-100' : 'opacity-0'}`}
          >
            <div className="absolute inset-0 z-10 bg-[linear-gradient(160deg,var(--hero),var(--hero-d))] mix-blend-multiply" />
            {slide.img ? (
              <img
                src={slide.img}
                alt=""
                className={`h-full w-full object-cover transition-transform duration-[7500ms] ease-out ${activeIndex === i ? 'scale-100' : 'scale-[1.07]'}`}
              />
            ) : (
              <div
                aria-hidden="true"
                className="h-full w-full"
                style={{ background: `linear-gradient(135deg, ${'color' in slide ? slide.color : '#3d9be3'}, #172335)` }}
              />
            )}
            <div className="absolute inset-0 z-10 bg-[linear-gradient(to_right,rgba(21,52,84,0.9),rgba(21,52,84,0.3))]" />
          </div>
        ))}

        <div className="relative z-10 flex items-center justify-between px-6 py-6 sm:px-12 lg:px-20">
          <Brand cream />
          <SessionButton />
        </div>

        <div className="relative z-10 flex flex-1 items-center px-6 py-10 sm:px-12 lg:px-20">
          <div className="max-w-3xl rounded-3xl border border-white/10 bg-[#102b46]/45 p-5 shadow-2xl backdrop-blur-[2px] sm:p-8">
            {slides[activeIndex].heroT ? (
              <h1
                className="mb-5 max-w-3xl text-[clamp(2rem,3.6vw,3.75rem)] text-[var(--cream)]"
                dangerouslySetInnerHTML={{ __html: slides[activeIndex].heroT }}
              />
            ) : (
              <h1 className="mb-5 max-w-3xl text-[clamp(2rem,3.6vw,3.75rem)] text-[var(--cream)]">
                Próximamente: {slides[activeIndex].name}
              </h1>
            )}
            <p className="mb-8 max-w-2xl text-base leading-relaxed text-white sm:mb-10 sm:text-lg lg:text-xl">
              {slides[activeIndex].heroS || `Estamos preparando ${slides[activeIndex].name}. Conoce los productos disponibles de la suite.`}
            </p>
            <div className="flex flex-wrap gap-4">
              {slides[activeIndex].id === 'plat' ? (
                <>
                  <Button
                    variant="cream"
                    onClick={() => document.getElementById('productos')?.scrollIntoView({ behavior: 'smooth' })}
                  >
                    Descubrir productos
                  </Button>
                  <Button variant="ghost-dark" onClick={() => setShowCallModal(true)}>
                    Agendar llamada
                  </Button>
                </>
              ) : (
                slides[activeIndex].enabled ? (
                  <Button variant="cream" onClick={() => handleCardClick(activeIndex)}>
                    Ver producto →
                  </Button>
                ) : (
                  <Button
                    variant="cream"
                    onClick={() => document.getElementById('productos')?.scrollIntoView({ behavior: 'smooth' })}
                  >
                    Conocer productos
                  </Button>
                )
              )}
            </div>
          </div>
        </div>

        <div className="relative z-10 grid grid-cols-2 gap-3 px-6 py-6 sm:gap-4 sm:px-12 lg:px-20 md:grid-cols-5">
          {slides.map((slide, i) => {
            const isActive = activeIndex === i;
            const subtitle = slide.id === 'plat' ? slide.sub : slide.tag;
            const progressColor = slide.id === 'plat' ? 'bg-[var(--accent)]' : slideProgressColors[slide.id];
            return (
              <button
                type="button"
                key={slide.id}
                onClick={() => handleCardClick(i)}
                onMouseEnter={() => setActiveIndex(i)}
                className={`cursor-pointer overflow-hidden rounded-2xl border text-left transition-all duration-300 ${
                  isActive
                    ? 'border-transparent bg-[var(--cream)] text-[var(--ink)]'
                    : 'border-white/10 bg-[rgba(14,38,62,0.46)] text-[var(--cream)] backdrop-blur-[10px]'
                }`}
              >
                <div className="h-14 overflow-hidden sm:h-[68px]">
                  {slide.thumb ? (
                    <img
                      src={slide.thumb}
                      alt=""
                      className={`h-full w-full object-cover ${isActive ? '' : 'grayscale opacity-60'}`}
                    />
                  ) : (
                    <div
                      aria-hidden="true"
                      className="h-full w-full"
                      style={{ background: `linear-gradient(135deg, ${'color' in slide ? slide.color : '#3d9be3'}, #172335)` }}
                    />
                  )}
                </div>
                <div className="px-4 py-3 sm:px-5 sm:py-4">
                  <div className="truncate font-[var(--font-heading)] text-sm font-semibold sm:text-base">
                    {slide.name}
                  </div>
                  <div className={`truncate text-xs sm:text-[13px] ${isActive ? 'opacity-70' : 'opacity-70'}`}>
                    {subtitle}
                  </div>
                </div>
                <div className="h-[3px] w-full bg-black/10">
                  <div
                    className={`h-full ${
                      progressColor
                    } ${isActive && !isHovering ? 'w-full transition-[width] duration-[5200ms] ease-linear' : 'w-0 transition-none'}`}
                  />
                </div>
              </button>
            );
          })}
        </div>
      </section>

      <section id="productos" className="container py-20 sm:py-24">
        <div className="reveal mb-12 text-center sm:mb-16">
          <span className="text-[13px] font-bold tracking-[1.5px] text-[var(--accent)]">PRODUCTOS</span>
          <h2 className="my-4 text-[clamp(2rem,4vw,3.25rem)]">Una suite. Cuatro formas de ganar tiempo.</h2>
          <p className="mx-auto max-w-[600px] text-lg text-[var(--mut)] sm:text-xl">
            Cada herramienta está diseñada para resolver un problema específico de tu negocio. Úsalas por separado o combínalas.
          </p>
        </div>

        <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((product, i) => (
            <div
              key={product.id}
              className={`reveal overflow-hidden rounded-3xl border border-white/20 bg-white/70 shadow-lg backdrop-blur-md transition-all duration-300 hover:shadow-xl dark:border-white/10 dark:bg-slate-900/60 ${product.enabled ? 'cursor-pointer' : 'cursor-default'} ${revealDelays[i]}`}
              onClick={() => product.enabled ? navigate(`/producto/${product.id}`) : addToast('Disponible próximamente', 'warn')}
              role="link"
              tabIndex={0}
              onKeyDown={event => {
                if (event.key === 'Enter' || event.key === ' ') {
                  event.preventDefault();
                  product.enabled ? navigate(`/producto/${product.id}`) : addToast('Disponible próximamente', 'warn');
                }
              }}
            >
              <div className="h-44 overflow-hidden">
                {product.thumb ? (
                  <img
                    src={product.thumb}
                    alt={product.name}
                    className="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                  />
                ) : (
                  <div
                    aria-label={`${product.name}, próximamente`}
                    className="flex h-full flex-col items-center justify-center gap-3 text-white"
                    style={{ background: `linear-gradient(135deg, ${product.color}, #172335)` }}
                  >
                    <Badge text={product.badge} color="rgba(255,255,255,0.2)" />
                    <span className="text-sm font-medium tracking-wide">Próximamente</span>
                  </div>
                )}
              </div>
              <div className="p-6">
                <Badge text={product.badge} color={product.color} />
                <h3 className="mt-4 text-3xl">{product.name}</h3>
                <p className="mb-4 text-sm text-[var(--mut)]">{product.tag}</p>
                <ul className="mb-6 flex flex-col gap-2">
                  {product.bullets.map((bullet, bulletIndex) => (
                    <li key={bulletIndex} className="flex items-center gap-2 text-sm text-[var(--ink)]">
                      <span className={productTextColors[product.id]}>{ic('check', 16)}</span>
                      {bullet}
                    </li>
                  ))}
                </ul>
                <div className="flex items-center justify-between border-t border-[var(--line)] pt-4">
                  <span className={`text-sm font-semibold ${productTextColors[product.id]}`}>
                    {product.enabled ? 'Ver producto →' : 'Próximamente'}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <Modal isOpen={showCallModal} onClose={() => setShowCallModal(false)} title="Agenda una llamada">
        <form
          onSubmit={event => {
            event.preventDefault();
            addToast('Te contactaremos en menos de 24 horas', 'success');
            setShowCallModal(false);
          }}
          className="flex flex-col gap-4"
        >
          <input
            required
            type="text"
            placeholder="Nombre completo"
            className="rounded-lg border-0 bg-white/10 p-3 text-white placeholder:text-white/60 focus:outline-none focus:ring-2 focus:ring-white/50"
          />
          <input
            required
            type="email"
            placeholder="Email de trabajo"
            className="rounded-lg border-0 bg-white/10 p-3 text-white placeholder:text-white/60 focus:outline-none focus:ring-2 focus:ring-white/50"
          />
          <Button variant="blue" type="submit" className="mt-2 justify-center">Solicitar llamada</Button>
        </form>
      </Modal>
    </div>
  );
};
</file>

<file path="src/views/ProductDetail.tsx">
import { useEffect } from 'react';
import { useParams, Link, useNavigate } from 'react-router-dom';
import { products } from '../data/products';
import { useAppContext } from '../context/AppContext';
import { Badge, Button } from '../components/UI';
import { ic } from '../utils/icons';
import { useReveal } from '../hooks/useReveal';
import { subscriptionSections } from '../products/subscriptionRegistry';
import type { Product } from '../types';

const productTheme: Record<Product['id'], { text: string; glow: string; panel: string }> = {
  stockia: {
    text: 'text-[#0e9f6e]',
    glow: 'bg-[radial-gradient(circle,rgba(14,159,110,0.2)_0%,transparent_70%)]',
    panel: 'bg-[#0e9f6e]/[0.03]'
  },
  citalis: {
    text: 'text-[#2f9ec4]',
    glow: 'bg-[radial-gradient(circle,rgba(47,158,196,0.2)_0%,transparent_70%)]',
    panel: 'bg-[#2f9ec4]/[0.03]'
  },
  turnia: {
    text: 'text-[#d97b29]',
    glow: 'bg-[radial-gradient(circle,rgba(217,123,41,0.2)_0%,transparent_70%)]',
    panel: 'bg-[#d97b29]/[0.03]'
  },
  mesa: {
    text: 'text-[#8a5cd6]',
    glow: 'bg-[radial-gradient(circle,rgba(138,92,214,0.2)_0%,transparent_70%)]',
    panel: 'bg-[#8a5cd6]/[0.03]'
  }
};

export const ProductDetail = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const { loggedIn, subs, addToast } = useAppContext();
  const product = products.find(item => item.id === id);
  useReveal();

  useEffect(() => {
    if (!product) navigate('/');
    else window.scrollTo(0, 0);
  }, [product, navigate]);

  if (!product) return null;

  const isSubbed = loggedIn && subs.some(subscription => subscription.pid === product.id);
  const nextIdx = (products.findIndex(item => item.id === product.id) + 1) % products.length;
  const nextProduct = products[nextIdx];
  const theme = productTheme[product.id];
  const SubscriptionSection = subscriptionSections[product.id];

  const handleEmpezar = () => {
    document.getElementById('seccion-suscripcion')?.scrollIntoView({ behavior: 'smooth' });
  };

  const handleIntentoDeSuscripcion = (metodo: 'domiciliado' | 'oxxo' | 'tarjeta') => {
    const metodoTexto = metodo === 'domiciliado'
      ? 'pago domiciliado'
      : metodo === 'oxxo' ? 'pago único en OXXO' : 'pago con tarjeta';
    addToast(`Datos validados. La integración de ${metodoTexto} todavía no está disponible; no se creó una suscripción.`, 'warn');
  };

  return (
    <div>
      <div className="container pb-20 pt-16 sm:pt-20">
        <Link
          to="/"
          className="mb-12 inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-white/55 px-4 py-2 text-[var(--mut)] transition-colors hover:text-[var(--ink)]"
        >
          {ic('arrowL', 16)} Todos los productos
        </Link>

        <section className="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-16">
          <div className="reveal">
            <div className="mb-6 flex flex-wrap items-center gap-3">
              <Badge text={product.badge} color={product.color} />
              <span className="text-lg font-semibold">{product.name}</span>
              <span className="text-[var(--mut)]">·</span>
              <span className="text-[var(--mut)]">{product.tag}</span>
            </div>
            <h1 className="mb-6 text-4xl sm:text-5xl lg:text-6xl">{product.heroT}</h1>
            <p className="mb-10 text-lg text-[var(--mut)] sm:text-xl">{product.heroS}</p>
            <div className="flex flex-wrap gap-4">
              {isSubbed && product.id !== 'stockia' ? (
                <Button variant="dark" to="/cuenta">Gestionar suscripción</Button>
              ) : (
                <>
                  <Button variant="dark" onClick={handleEmpezar}>
                    {isSubbed ? 'Contratar otra tienda' : 'Empezar ahora'}
                  </Button>
                  {isSubbed && <Button variant="glass" to="/cuenta">Gestionar suscripciones</Button>}
                </>
              )}
            </div>
          </div>

          <div className="reveal relative animate-[float_7s_ease-in-out_infinite_alternate]">
            <div className={`absolute -inset-5 z-0 ${theme.glow}`} />
            <div className="relative z-10 h-[320px] overflow-hidden rounded-2xl border border-[var(--line)] bg-white shadow-[0_25px_50px_rgba(0,0,0,0.1)] sm:h-[400px]">
              <div className="flex gap-2 border-b border-[var(--line)] bg-[#f8f9fa] px-4 py-3">
                <div className="h-3 w-3 rounded-full bg-[#ff5f56]" />
                <div className="h-3 w-3 rounded-full bg-[#ffbd2e]" />
                <div className="h-3 w-3 rounded-full bg-[#27c93f]" />
              </div>
              <div className="flex h-[calc(100%-41px)]">
                <div className="flex w-[120px] shrink-0 flex-col gap-3 border-r border-[var(--line)] p-3 sm:p-4">
                  {product.mock.side.map((item, i) => (
                    <div
                      key={i}
                      className={`truncate text-xs sm:text-[13px] ${i === 1 ? `${theme.text} font-semibold` : 'text-[var(--mut)]'}`}
                    >
                      {item}
                    </div>
                  ))}
                </div>
                <div className={`min-w-0 flex-1 p-4 sm:p-6 ${theme.panel}`}>
                  <div className="mb-6 h-6 w-2/5 rounded bg-black/5" />
                  <div className="mb-6 flex gap-4">
                    <div className="h-20 min-w-0 flex-1 rounded-lg border border-[var(--line)] bg-white" />
                    <div className="h-20 min-w-0 flex-1 rounded-lg border border-[var(--line)] bg-white" />
                  </div>
                  <div className="h-[140px] rounded-lg border border-[var(--line)] bg-white" />
                </div>
              </div>
            </div>
          </div>
        </section>

        <section className="mt-28 sm:mt-36">
          <h2 className="mb-14 text-center text-4xl sm:mb-16 sm:text-5xl">Todo lo que incluye</h2>

          <div className="flex flex-col gap-16 sm:gap-20">
            {product.detailedFeats.map((feature, i) => (
              <div
                key={i}
                className={`reveal flex flex-col items-center gap-8 rounded-3xl border border-white/35 bg-white/20 p-5 text-center shadow-sm backdrop-blur-sm sm:p-8 md:gap-12 md:text-left ${
                  i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'
                }`}
              >
                <div className="w-full min-w-0 flex-1">
                  <h3 className="mb-4 text-2xl text-[var(--ink)] sm:text-3xl">{feature.t}</h3>
                  <p className="text-base leading-relaxed text-[var(--mut)] sm:text-lg">{feature.d}</p>
                </div>
                <div className="w-full min-w-0 flex-1">
                  <img
                    src={feature.img}
                    alt={feature.t}
                    className="aspect-[4/3] w-full rounded-3xl object-cover shadow-[0_20px_40px_rgba(0,0,0,0.1)]"
                  />
                </div>
              </div>
            ))}
          </div>
        </section>

        {SubscriptionSection ? (
          <SubscriptionSection alContinuar={handleIntentoDeSuscripcion} />
        ) : (
          <section id="seccion-suscripcion" className="mt-24 text-center sm:mt-[120px]">
            <h2 className="mb-4 text-4xl">Suscripción próximamente</h2>
            <p className="text-[var(--mut)]">Este producto todavía no tiene su flujo de contratación configurado.</p>
          </section>
        )}

        <section className="mt-24 sm:mt-[120px]">
          <button
            type="button"
            onClick={() => {
              if (nextProduct.enabled) navigate(`/producto/${nextProduct.id}`);
              else addToast('Próximamente', 'warn');
            }}
            className="flex w-full cursor-pointer items-center justify-between rounded-3xl border border-white/20 bg-white/70 p-6 text-left shadow-lg backdrop-blur-md transition-all hover:shadow-xl dark:border-white/10 dark:bg-slate-900/60 sm:p-10"
          >
            <span>
              <span className="mb-2 block text-sm text-[var(--mut)]">Siguiente producto</span>
              <span className={`block text-2xl font-bold ${productTheme[nextProduct.id].text}`}>
                {nextProduct.name}
              </span>
            </span>
            <span className={productTheme[nextProduct.id].text}>{ic('arrowR', 32)}</span>
          </button>
        </section>
      </div>
    </div>
  );
};
</file>

