* { box-sizing: border-box; }

body {
  font-family: var(--font-body);
  background: 
    radial-gradient(circle at 90% 10%, rgba(90,170,230,.16) 0%, transparent 40%),
    radial-gradient(circle at 10% 90%, rgba(180,170,160,.2) 0%, transparent 40%),
    radial-gradient(circle at 50% 100%, rgba(200,190,180,.3) 0%, transparent 40%),
    linear-gradient(to bottom, #f7f1e6, #f0e9da);
  background-attachment: fixed;
  color: var(--ink);
  line-height: 1.6;
  overflow-x: hidden;
}

h1, h2, h3, h4 {
  font-family: var(--font-heading);
  letter-spacing: -0.02em;
  font-weight: 600;
  line-height: 1.2;
}

a { text-decoration: none; color: inherit; }
button { font-family: inherit; cursor: pointer; border: none; background: none; }
ul { list-style: none; }

/* Utilities */
.glass {
  background: var(--glass);
  border: 1px solid var(--glass-brd);
  backdrop-filter: blur(14px);
