create or replace function public.stockia_package_amount(
  p_plan_code text,
  p_duration_months integer
)
returns numeric
language plpgsql
stable
security definer
set search_path = ''
as $$
declare
  v_amount numeric(10, 2);
begin
  select package.precio_final_mxn
  into v_amount
  from public.vista_paquetes_calculados as package
  where package.producto = 'STOCKIA'
    and package.plan_codigo_remoto = p_plan_code
    and package.meses = p_duration_months
    and package.activo;

  if not found then
    raise exception 'El plan o paquete de MiTienda no está disponible';
  end if;

  return v_amount;
end;
$$;

revoke all on function public.stockia_package_amount(text, integer) from public, anon, authenticated;

create or replace function public.consume_signup_code_and_create_registration()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_metadata jsonb := coalesce(new.raw_user_meta_data, '{}'::jsonb);
  v_promo_code text := upper(btrim(coalesce(v_metadata ->> 'promo_code', '')));
  v_product_id text := lower(btrim(coalesce(v_metadata ->> 'product_id', '')));
  v_plan_code text := upper(btrim(coalesce(v_metadata ->> 'plan_code', '')));
  v_duration_months integer;
  v_amount_due numeric(10, 2);
  v_promo_days integer;
  v_full_name text := btrim(coalesce(v_metadata ->> 'full_name', ''));
  v_store_name text := btrim(coalesce(v_metadata ->> 'store_name', ''));
  v_pin_hash text := coalesce(v_metadata ->> 'pin_hash', '');
  v_registration_id uuid;
begin
  if v_product_id = '' and v_promo_code = '' then
    return new;
  end if;

  if v_product_id <> 'stockia' or v_promo_code = '' then
    raise exception 'Se requiere un código promocional válido para registrar MiTienda';
  end if;

  if v_plan_code not in ('BASICO', 'ESTANDAR', 'PLUS') then
    raise exception 'El plan de MiTienda no es válido';
  end if;

  if coalesce(v_metadata ->> 'duration_months', '') not in ('1', '3', '6', '12') then
    raise exception 'La duración del paquete no es válida';
  end if;
  v_duration_months := (v_metadata ->> 'duration_months')::integer;

  if char_length(v_full_name) not between 2 and 120
    or char_length(v_store_name) not between 2 and 120
    or v_pin_hash !~ '^[A-Za-z0-9+/]{8}$' then
    raise exception 'Los datos del dueño o de la tienda no son válidos';
  end if;

  v_amount_due := public.stockia_package_amount(v_plan_code, v_duration_months);

  update public.codigos_promocionales_saas
  set used_by = new.id,
      used_at = now()
  where code_hash = encode(extensions.digest(v_promo_code, 'sha256'), 'hex')
    and activo
    and used_at is null
    and (expires_at is null or expires_at > now())
  returning dias_prueba into v_promo_days;

  if not found then
    raise exception 'El código promocional no es válido, expiró o ya fue utilizado';
  end if;

  insert into public.subscription_registrations (
    user_id,
    product_id,
    plan_code,
    duration_months,
    amount_due,
    full_name,
    store_name,
    status,
    promo_days,
    pin_hash
  ) values (
    new.id,
    'stockia',
    v_plan_code,
    v_duration_months,
    v_amount_due,
    v_full_name,
    v_store_name,
    'provisioning',
    v_promo_days,
    v_pin_hash
  )
  returning id into v_registration_id;

  new.raw_user_meta_data := v_metadata - 'promo_code' - 'pin_hash' - 'signup_code';
  new.raw_app_meta_data := coalesce(new.raw_app_meta_data, '{}'::jsonb) || jsonb_build_object(
    'registration_status', 'trial_provisioning',
    'pending_registration_id', v_registration_id,
    'product_id', 'stockia',
    'plan_code', v_plan_code,
    'promo_days', v_promo_days
  );

  return new;
end;
$$;

drop trigger if exists on_auth_user_created_consume_signup_code on auth.users;
create trigger on_auth_user_created_consume_signup_code
before insert on auth.users
for each row
execute function public.consume_signup_code_and_create_registration();

revoke all on function public.consume_signup_code_and_create_registration() from public, anon, authenticated;

create or replace function public.create_customer_promo_registration(
