  v_plan_code text := upper(btrim(coalesce(p_plan_code, '')));
  v_promo_days integer;
  v_amount_due numeric(10, 2);
  v_registration_id uuid;
begin
  if p_user_id is null or coalesce(btrim(p_promo_code), '') = '' then
