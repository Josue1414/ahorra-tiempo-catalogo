    or coalesce(btrim(p_store_name), '') !~ '^.{2,120}$'
    or coalesce(p_pin_hash, '') !~ '^[A-Za-z0-9+/]{8}$' then
    raise exception 'Los datos del dueño, la tienda o el paquete no son válidos';
  end if;

  v_amount_due := public.stockia_package_amount(v_plan_code, p_duration_months);

  update public.codigos_promocionales_saas
  set used_by = p_user_id,
      used_at = now()
  where code_hash = encode(extensions.digest(upper(btrim(p_promo_code)), 'sha256'), 'hex')
    and activo
    and used_at is null
    and (expires_at is null or expires_at > now())
  returning dias_prueba into v_promo_days;

  if not found then
    raise exception 'El código promocional no es válido, expiró o ya fue utilizado';
  end if;

  insert into public.subscription_registrations (
    user_id,
    product_id,
    plan_code,
    duration_months,
    amount_due,
    full_name,
    store_name,
    status,
    promo_days,
    pin_hash
  ) values (
    p_user_id,
    'stockia',
    v_plan_code,
    p_duration_months,
    v_amount_due,
    btrim(p_full_name),
    btrim(p_store_name),
    'provisioning',
    v_promo_days,
    p_pin_hash
  )
  returning id into v_registration_id;

  update auth.users
  set raw_app_meta_data = coalesce(raw_app_meta_data, '{}'::jsonb) || jsonb_build_object(
