  to service_role;

create or replace function public.admin_generar_codigo_promocional(p_dias_prueba integer)
returns table (codigo text, dias_prueba integer, creado_en timestamptz)
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_code text;
  v_attempt integer;
begin
  if not public.es_super_admin_saas() then
    raise exception 'Se requiere rol de superadministrador';
  end if;

  if p_dias_prueba not between 1 and 90 then
    raise exception 'Los días de prueba deben estar entre 1 y 90';
  end if;

  for v_attempt in 1..5 loop
    v_code := upper(encode(extensions.gen_random_bytes(12), 'hex'));

    insert into public.codigos_promocionales_saas (code_hash, dias_prueba, created_by)
    values (
      encode(extensions.digest(v_code, 'sha256'), 'hex'),
      p_dias_prueba,
      auth.uid()
    )
    on conflict (code_hash) do nothing;

    if found then
      return query select v_code, p_dias_prueba, now();
      return;
    end if;
  end loop;

  raise exception 'No se pudo generar un código promocional único';
end;
$$;

revoke all on function public.admin_generar_codigo_promocional(integer) from public, anon;
grant execute on function public.admin_generar_codigo_promocional(integer) to authenticated;
</file>

