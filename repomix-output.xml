import { createClient } from 'npm:@supabase/supabase-js@2';

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
  'Access-Control-Allow-Methods': 'POST, OPTIONS'
};

interface SubscriptionRow {
  id: string;
  tienda_remota_id: string | null;
  nombre_tienda: string | null;
  plan_codigo: string;
  meses_contratados: number;
  metodo_pago: string;
  estado: string;
  es_prueba_gratis: boolean;
  fecha_vencimiento: string;
  created_at: string;
}

interface RemoteStoreRow {
  id: string;
  nombre: string;
  plan_id: string | null;
  fecha_vencimiento: string;
  bloqueado: boolean;
  es_prueba_gratis: boolean;
  max_dispositivos: number;
}

interface MemberRow {
  tienda_id: string;
  usuario_id: string;
  rol: string;
  nombre: string;
  activo: boolean;
  created_at: string;
}

interface PaymentRow {
  suscripcion_id: string;
  concepto: string;
  meses_pagados: number;
  monto_pagado: number;
  metodo: string;
  estado: string;
  created_at: string;
}

function jsonResponse(status: number, body: unknown) {
  return new Response(JSON.stringify(body), {
    status,
    headers: { ...corsHeaders, 'Content-Type': 'application/json' }
  });
}

Deno.serve(async request => {
  if (request.method === 'OPTIONS') return new Response('ok', { headers: corsHeaders });
  if (request.method !== 'POST') return jsonResponse(405, { error: 'Método no permitido.' });

  const masterUrl = Deno.env.get('SUPABASE_URL');
  const masterAnonKey = Deno.env.get('SUPABASE_ANON_KEY');
  const masterServiceKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY');
  const tiendaUrl = Deno.env.get('MITIENDA_SUPABASE_URL');
  const tiendaServiceKey = Deno.env.get('MITIENDA_SERVICE_ROLE_KEY');

  if (!masterUrl || !masterAnonKey || !masterServiceKey) {
    console.error('Falta configurar el entorno Supabase Master para mitienda-dashboard.');
    return jsonResponse(500, { error: 'El servicio de métricas no está configurado.' });
  }

  const authorization = request.headers.get('Authorization');
  if (!authorization) return jsonResponse(401, { error: 'Inicia sesión para consultar tus métricas.' });

  const masterUserClient = createClient(masterUrl, masterAnonKey, {
    global: { headers: { Authorization: authorization } },
    auth: { persistSession: false, autoRefreshToken: false }
  });
  const { data: userData, error: userError } = await masterUserClient.auth.getUser();
  if (userError || !userData.user) {
    return jsonResponse(401, { error: 'La sesión no es válida. Inicia sesión de nuevo.' });
  }

  const masterAdmin = createClient(masterUrl, masterServiceKey, {
    auth: { persistSession: false, autoRefreshToken: false }
  });
  const { data: subscriptionData, error: subscriptionError } = await masterAdmin
    .from('suscripciones_clientes')
    .select('id, tienda_remota_id, nombre_tienda, plan_codigo, meses_contratados, metodo_pago, estado, es_prueba_gratis, fecha_vencimiento, created_at')
    .eq('user_id', userData.user.id)
    .eq('producto', 'STOCKIA')
    .order('created_at', { ascending: false });

  if (subscriptionError) {
    console.error('No se pudieron consultar las suscripciones Master:', subscriptionError.message);
    return jsonResponse(502, { error: 'No se pudieron consultar tus suscripciones.' });
  }

  const subscriptions = (subscriptionData ?? []) as SubscriptionRow[];
  const subscriptionIds = subscriptions.map(subscription => subscription.id);
  const storeIds = subscriptions
    .map(subscription => subscription.tienda_remota_id)
    .filter((storeId): storeId is string => Boolean(storeId));

  if (subscriptions.length === 0) {
    return jsonResponse(200, {
      stores: [],
      payments: [],
      accountEmail: userData.user.email ?? ''
    });
  }

  if (!tiendaUrl || !tiendaServiceKey) {
    console.error('Falta configurar el acceso servidor a MiTienda para mitienda-dashboard.');
    return jsonResponse(500, { error: 'El acceso a las métricas de MiTienda no está configurado.' });
  }

  if (storeIds.length === 0) {
    return jsonResponse(200, {
      stores: [],
      payments: [],
      accountEmail: userData.user.email ?? '',
      warning: 'Las suscripciones aún no tienen tiendas MiTienda vinculadas.'
    });
  }

  const tiendaAdmin = createClient(tiendaUrl, tiendaServiceKey, {
    auth: { persistSession: false, autoRefreshToken: false }
  });
  const [storesResult, membersResult, paymentsResult] = await Promise.all([
    tiendaAdmin
      .from('tiendas')
      .select('id, nombre, plan_id, fecha_vencimiento, bloqueado, es_prueba_gratis, max_dispositivos')
      .in('id', storeIds),
    tiendaAdmin
      .from('miembros_tienda')
      .select('tienda_id, usuario_id, rol, nombre, activo, created_at')
      .in('tienda_id', storeIds)
      .order('created_at', { ascending: true }),
    masterAdmin
      .from('pagos_clientes')
      .select('suscripcion_id, concepto, meses_pagados, monto_pagado, metodo, estado, created_at')
      .in('suscripcion_id', subscriptionIds)
      .order('created_at', { ascending: false })
      .limit(30)
  ]);

  if (storesResult.error || membersResult.error) {
    const message = storesResult.error?.message ?? membersResult.error?.message;
    console.error('No se pudieron consultar las tiendas o sus miembros en MiTienda:', message);
    return jsonResponse(502, { error: 'No se pudieron cargar las tiendas y sus usuarios.' });
  }
  if (paymentsResult.error) {
    console.error('No se pudieron consultar los pagos Master:', paymentsResult.error.message);
    return jsonResponse(502, { error: 'No se pudo cargar el historial de pagos.' });
  }

  const stores = (storesResult.data ?? []) as RemoteStoreRow[];
  const members = (membersResult.data ?? []) as MemberRow[];
  const payments = (paymentsResult.data ?? []) as PaymentRow[];
  const storeById = new Map(stores.map(store => [store.id, store]));

  return jsonResponse(200, {
    accountEmail: userData.user.email ?? '',
    stores: subscriptions.map(subscription => {
      const store = subscription.tienda_remota_id
        ? storeById.get(subscription.tienda_remota_id) ?? null
        : null;
      const team = members
        .filter(member => member.tienda_id === subscription.tienda_remota_id)
        .map(member => ({
          userId: member.usuario_id,
          name: member.nombre,
          role: member.rol,
          active: member.activo,
          createdAt: member.created_at
        }));

      return {
        subscriptionId: subscription.id,
        storeId: subscription.tienda_remota_id,
        name: store?.nombre ?? subscription.nombre_tienda ?? 'Tienda sin nombre',
        plan: subscription.plan_codigo,
        months: subscription.meses_contratados,
        paymentMethod: subscription.metodo_pago,
        status: subscription.estado,
        isFreeTrial: subscription.es_prueba_gratis || store?.es_prueba_gratis === true,
        expiresAt: store?.fecha_vencimiento ?? subscription.fecha_vencimiento,
        blocked: store?.bloqueado ?? false,
        maxDevices: store?.max_dispositivos ?? null,
        team,
        activeTeamCount: team.filter(member => member.active).length,
        ownerName: team.find(member => member.role === 'DUENO' && member.active)?.name ?? null
      };
    }),
    payments
  });
});
