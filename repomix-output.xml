      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: 24, marginBottom: 48 }}>
        {[
          { i: 'shield', l: 'Plan de cuenta', v: user.plan },
          { i: 'box', l: 'Productos activos', v: `${subs.length} de ${products.length}` },
          { i: 'calendar', l: 'Próxima renovación', v: '30 nov 2025' },
          { i: 'creditCard', l: 'Consumo mensual', v: '$112.00' }
        ].map((c, i) => (
          <div key={i} className="glass reveal" style={{ padding: 20, borderRadius: 16, display: 'flex', gap: 16, alignItems: 'center' }}>
            <div style={{ color: 'var(--accent)' }}>{ic(c.i as any, 24)}</div>
            <div>
              <div style={{ fontSize: 13, color: 'var(--mut)' }}>{c.l}</div>
              <div style={{ fontWeight: 600, fontSize: 16 }}>{c.v}</div>
            </div>
          </div>
        ))}
      </div>

      {/* Subscriptions */}
      <h2 style={{ fontSize: '1.8rem', marginBottom: 24 }}>Productos contratados</h2>
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(450px, 1fr))', gap: 24, marginBottom: 64 }}>
        {subs.map((s, i) => {
          const p = products.find(x => x.id === s.pid)!;
          return (
            <div key={i} className="glass reveal" style={{ borderRadius: 20, overflow: 'hidden' }}>
              <div style={{ padding: 24, borderBottom: '1px solid var(--line)' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 16 }}>
                  <div style={{ display: 'flex', gap: 16, alignItems: 'center' }}>
                    <Badge text={p.badge} color={p.color} />
                    <div>
                      <div style={{ fontWeight: 700, fontSize: 18 }}>{p.name}</div>
                      <div style={{ fontSize: 13, color: 'var(--mut)' }}>{p.tag}</div>
                    </div>
                  </div>
                  <div style={{ background: 'rgba(11,122,80,0.1)', color: 'var(--ok)', padding: '4px 12px', borderRadius: 999, fontSize: 12, fontWeight: 600 }}>Activo</div>
                </div>
                <div style={{ fontSize: 13, color: 'var(--mut)', marginBottom: 8 }}>Uso de licencias: {s.users} ({s.upct}%)</div>
                <div style={{ height: 4, background: 'rgba(0,0,0,0.05)', borderRadius: 2, overflow: 'hidden' }}>
                  <div style={{ width: `${s.upct}%`, height: '100%', background: p.color }} />
                </div>
              </div>
              <div style={{ padding: 24, background: 'rgba(255,255,255,0.3)', display: 'grid', gridTemplateColumns: '1fr 1fr 1fr', gap: 16, fontSize: 13 }}>
                <div><div style={{ color: 'var(--mut)' }}>ID Suscripción</div><div style={{ fontWeight: 500 }}>{s.sid}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Versión</div><div style={{ fontWeight: 500 }}>v{s.ver}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Renovación</div><div style={{ fontWeight: 500 }}>{s.renewal}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Uptime</div><div style={{ fontWeight: 500 }}>{s.uptime}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Llamadas API</div><div style={{ fontWeight: 500 }}>{s.api}</div></div>
                <div><div style={{ color: 'var(--mut)' }}>Último backup</div><div style={{ fontWeight: 500 }}>{s.backup}</div></div>
              </div>
              <div style={{ padding: 16, borderTop: '1px solid var(--line)', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <div style={{ fontSize: 13, color: 'var(--mut)' }}>{s.plan} · Cliente desde {s.since}</div>
                <Button variant="dark" to={`/producto/${p.id}`}>Abrir producto →</Button>
              </div>
            </div>
          );
        })}
      </div>

      {/* Invoices */}
      <h2 style={{ fontSize: '1.8rem', marginBottom: 24 }}>Facturación reciente</h2>
      <div className="glass reveal" style={{ borderRadius: 16, overflow: 'hidden', marginBottom: 64 }}>
        <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left' }}>
          <thead style={{ background: 'rgba(0,0,0,0.03)' }}>
            <tr>
              <th style={{ padding: '16px 24px', fontWeight: 600, fontSize: 14 }}>Fecha</th>
              <th style={{ padding: '16px 24px', fontWeight: 600, fontSize: 14 }}>Concepto</th>
              <th style={{ padding: '16px 24px', fontWeight: 600, fontSize: 14 }}>Estado</th>
              <th style={{ padding: '16px 24px', fontWeight: 600, fontSize: 14, textAlign: 'right' }}>Importe</th>
              <th style={{ padding: '16px 24px' }}></th>
            </tr>
          </thead>
          <tbody>
            {invoices.map((inv, i) => (
              <tr key={i} style={{ borderTop: '1px solid var(--line)' }}>
                <td style={{ padding: '16px 24px', fontSize: 14 }}>{inv.date}</td>
                <td style={{ padding: '16px 24px', fontSize: 14 }}>{inv.concept}</td>
                <td style={{ padding: '16px 24px' }}><span style={{ background: 'rgba(11,122,80,0.1)', color: 'var(--ok)', padding: '2px 8px', borderRadius: 4, fontSize: 12 }}>{inv.status}</span></td>
                <td style={{ padding: '16px 24px', fontSize: 14, fontWeight: 600, textAlign: 'right' }}>{inv.amount}</td>
                <td style={{ padding: '16px 24px', textAlign: 'right' }}><button onClick={handleProx} style={{ color: 'var(--mut)' }}>{ic('download', 18)}</button></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
};
</file>

<file path="src/views/Home.tsx">
// src/views/Home.tsx
import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { products, platformSlide } from '../data/products';
import { useAppContext } from '../context/AppContext';
import { Brand, Badge, Button } from '../components/UI';
import { SessionButton } from '../components/SessionButton';
import { ic } from '../utils/icons';
import { useReveal } from '../hooks/useReveal';
import { Modal } from '../components/Modal';

export const Home = () => {
  useReveal();
  const navigate = useNavigate();
  const { addToast } = useAppContext();
  const [activeIndex, setActiveIndex] = useState(0);
  const [isHovering, setIsHovering] = useState(false);
  const [showCallModal, setShowCallModal] = useState(false);
  
  const slides = [platformSlide, ...products];

  // Carousel logic
  useEffect(() => {
    if (isHovering) return;
    const timer = setInterval(() => {
      setActiveIndex(prev => (prev + 1) % slides.length);
    }, 5200);
    return () => clearInterval(timer);
  }, [isHovering, slides.length]);

  const handleCardClick = (idx: number) => {
    const slide = slides[idx];
    if (slide.id === 'plat') {
      document.getElementById('productos')?.scrollIntoView({ behavior: 'smooth' });
    } else {
      const prod = slide as typeof products[0];
      if (prod.enabled) {
        navigate(`/producto/${prod.id}`);
      } else {
        addToast('Disponible próximamente', 'warn');
      }
    }
  };

  return (
    <div>
      <section style={{ height: '100svh', position: 'relative', overflow: 'hidden', display: 'flex', flexDirection: 'column' }} onMouseEnter={() => setIsHovering(true)} onMouseLeave={() => setIsHovering(false)}>
        {/* Backgrounds */}
        {slides.map((s, i) => (
          <div key={s.id} style={{ position: 'absolute', inset: 0, opacity: activeIndex === i ? 1 : 0, transition: 'opacity 1s ease', zIndex: 0 }}>
            <div style={{ position: 'absolute', inset: 0, background: 'linear-gradient(160deg, var(--hero), var(--hero-d))', mixBlendMode: 'multiply' }} />
            <img src={s.img} alt="" style={{ width: '100%', height: '100%', objectFit: 'cover', transform: activeIndex === i ? 'scale(1)' : 'scale(1.07)', transition: 'transform 7.5s ease-out' }} />
            <div style={{ position: 'absolute', inset: 0, background: 'linear-gradient(to right, rgba(21,52,84,0.9), rgba(21,52,84,0.3))' }} />
          </div>
        ))}

        {/* Top bar */}
        <div style={{ position: 'relative', zIndex: 10, display: 'flex', justifyContent: 'space-between', padding: '24px 40px' }}>
          <Brand cream />
          <SessionButton />
        </div>

        {/* Hero Content */}
        <div style={{ position: 'relative', zIndex: 10, flex: 1, display: 'flex', alignItems: 'center', padding: '0 40px' }}>
          <div style={{ maxWidth: 640 }}>
            <h1 style={{ color: 'var(--cream)', fontSize: '4rem', marginBottom: 20 }} dangerouslySetInnerHTML={{ __html: slides[activeIndex].heroT }} />
            <p style={{ color: 'rgba(255,255,255,0.8)', fontSize: '1.25rem', marginBottom: 40, lineHeight: 1.5 }}>
              {slides[activeIndex].heroS}
            </p>
            <div style={{ display: 'flex', gap: 16 }}>
              {slides[activeIndex].id === 'plat' ? (
                <>
                  <Button variant="cream" onClick={() => document.getElementById('productos')?.scrollIntoView({ behavior: 'smooth' })}>Descubrir productos</Button>
                  <Button variant="ghost-dark" onClick={() => setShowCallModal(true)}>Agendar llamada</Button>
                </>
              ) : (
                <Button variant="cream" onClick={() => handleCardClick(activeIndex)}>Ver producto →</Button>
              )}
            </div>
          </div>
        </div>

        {/* Bottom Cards */}
        <div style={{ position: 'relative', zIndex: 10, padding: '24px 40px', display: 'grid', gridTemplateColumns: 'repeat(5, 1fr)', gap: 16 }}>
          {slides.map((s, i) => {
            const isActive = activeIndex === i;
            return (
              <div key={s.id} onClick={() => handleCardClick(i)} onMouseEnter={() => setActiveIndex(i)} style={{ background: isActive ? 'var(--cream)' : 'rgba(14,38,62,0.46)', backdropFilter: 'blur(10px)', borderRadius: 16, cursor: 'pointer', transition: 'all 0.3s', overflow: 'hidden', color: isActive ? 'var(--ink)' : 'var(--cream)', border: isActive ? '1px solid transparent' : '1px solid rgba(255,255,255,0.1)' }}>
                <div style={{ height: 58, overflow: 'hidden' }}>
                  <img src={s.thumb} alt="" style={{ width: '100%', height: '100%', objectFit: 'cover', filter: isActive ? 'none' : 'grayscale(100%) opacity(0.6)' }} />
                </div>
                <div style={{ padding: '12px 16px' }}>
                  <div style={{ fontWeight: 600, fontSize: 15, fontFamily: 'var(--font-heading)' }}>{s.name}</div>
                  <div style={{ fontSize: 12, opacity: isActive ? 0.7 : 0.5, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{s.id === 'plat' ? s.sub : (s as any).tag}</div>
                </div>
                {/* Progress bar */}
                <div style={{ height: 3, background: 'rgba(0,0,0,0.1)', width: '100%' }}>
                  <div style={{ height: '100%', background: s.id === 'plat' ? 'var(--accent)' : (s as any).color, width: isActive && !isHovering ? '100%' : '0%', transition: isActive && !isHovering ? 'width 5.2s linear' : 'none' }} />
                </div>
              </div>
            );
          })}
        </div>
      </section>

      {/* Products Section */}
      <section id="productos" className="container" style={{ padding: '100px 24px' }}>
        <div className="reveal" style={{ textAlign: 'center', marginBottom: 64 }}>
          <span style={{ color: 'var(--accent)', fontWeight: 700, fontSize: 13, letterSpacing: 1.5 }}>PRODUCTOS</span>
          <h2 style={{ fontSize: '3rem', margin: '16px 0' }}>Una suite. Cuatro formas de ganar tiempo.</h2>
          <p style={{ color: 'var(--mut)', fontSize: '1.2rem', maxWidth: 600, margin: '0 auto' }}>Cada herramienta está diseñada para resolver un problema específico de tu negocio. Úsalas por separado o combínalas.</p>
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(300px, 1fr))', gap: 24 }}>
          {products.map((p, i) => (
            <div key={p.id} className="glass reveal" style={{ borderRadius: 24, overflow: 'hidden', cursor: p.enabled ? 'pointer' : 'default', transitionDelay: `${i * 70}ms` }} onClick={() => p.enabled ? navigate(`/producto/${p.id}`) : addToast('Disponible próximamente', 'warn')}>
              <div style={{ height: 200, overflow: 'hidden' }}>
                <img src={p.thumb} style={{ width: '100%', height: '100%', objectFit: 'cover', transition: 'transform 0.5s' }} className="zoom-on-hover" />
              </div>
              <div style={{ padding: 24 }}>
                <Badge text={p.badge} color={p.color} />
                <h3 style={{ fontSize: '1.8rem', marginTop: 16 }}>{p.name}</h3>
                <p style={{ color: 'var(--mut)', fontSize: 14, marginBottom: 16 }}>{p.tag}</p>
                <ul style={{ display: 'flex', flexDirection: 'column', gap: 8, marginBottom: 24 }}>
                  {p.bullets.map((b, bi) => (
                    <li key={bi} style={{ display: 'flex', alignItems: 'center', gap: 8, fontSize: 14, color: 'var(--ink)' }}>
                      <span style={{ color: p.color }}>{ic('check', 16)}</span> {b}
                    </li>
                  ))}
                </ul>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid var(--line)', paddingTop: 16 }}>
                  
                  <span style={{ color: p.color, fontWeight: 600, fontSize: 14 }}>{p.enabled ? 'Ver producto →' : 'Próximamente'}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <Modal isOpen={showCallModal} onClose={() => setShowCallModal(false)} title="Agenda una llamada">
        <form onSubmit={(e) => { e.preventDefault(); addToast('Te contactaremos en menos de 24 horas', 'success'); setShowCallModal(false); }} style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
          <input required type="text" placeholder="Nombre completo" style={{ padding: 12, borderRadius: 8, border: 'none', background: 'rgba(255,255,255,0.1)', color: '#fff' }} />
          <input required type="email" placeholder="Email de trabajo" style={{ padding: 12, borderRadius: 8, border: 'none', background: 'rgba(255,255,255,0.1)', color: '#fff' }} />
          <Button variant="blue" type="submit" style={{ justifyContent: 'center', marginTop: 8 }}>Solicitar llamada</Button>
        </form>
      </Modal>

      <style>{`.zoom-on-hover:hover { transform: scale(1.05); }`}</style>
    </div>
  );
};
</file>

<file path="src/views/ProductDetail.tsx">
// src/views/ProductDetail.tsx
import React, { useState, useEffect } from 'react';
import { useParams, Link, useNavigate } from 'react-router-dom';
import { products } from '../data/products';
import { useAppContext } from '../context/AppContext';
import { Badge, Button } from '../components/UI';
import { ic } from '../utils/icons';
import { useReveal } from '../hooks/useReveal';
import { Modal } from '../components/Modal';

export const ProductDetail = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const { loggedIn, subs, addToast } = useAppContext();
  const p = products.find(x => x.id === id);
  useReveal();

  const [showSubModal, setShowSubModal] = useState(false);

  useEffect(() => {
    if (!p) navigate('/');
    else window.scrollTo(0, 0);
  }, [p, navigate]);

  if (!p) return null;

  const isSubbed = loggedIn && subs.some(s => s.pid === p.id);
  const nextIdx = (products.findIndex(x => x.id === p.id) + 1) % products.length;
  const nextP = products[nextIdx];

  return (
    <div style={{ '--pc': p.color, '--prgb': p.rgb } as React.CSSProperties}>
      <div className="container" style={{ paddingTop: 40, paddingBottom: 80 }}>
        <Link to="/" style={{ color: 'var(--mut)', display: 'inline-flex', alignItems: 'center', gap: 8, marginBottom: 40 }}>
          {ic('arrowL', 16)} Todos los productos
        </Link>

        {/* Hero Section */}
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 64, alignItems: 'center' }}>
          <div className="reveal">
            <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 24 }}>
              <Badge text={p.badge} color={p.color} />
              <span style={{ fontWeight: 600, fontSize: 18 }}>{p.name}</span>
              <span style={{ color: 'var(--mut)' }}>·</span>
              <span style={{ color: 'var(--mut)' }}>{p.tag}</span>
            </div>
            <h1 style={{ fontSize: '3.5rem', marginBottom: 24 }}>{p.heroT}</h1>
            <p style={{ fontSize: '1.2rem', color: 'var(--mut)', marginBottom: 40 }}>{p.heroS}</p>
            <div style={{ display: 'flex', gap: 16 }}>
              {isSubbed ? (
                <Button variant="dark" to="/cuenta">Gestionar suscripción</Button>
              ) : (
                <Button variant="dark" onClick={() => setShowSubModal(true)}>Empezar ahora</Button>
              )}
            </div>
          </div>
          
          <div className="reveal" style={{ animation: 'float 7s ease-in-out infinite alternate', position: 'relative' }}>
            <div style={{ position: 'absolute', inset: -20, background: `radial-gradient(circle, rgba(var(--prgb),0.2) 0%, transparent 70%)`, zIndex: -1 }} />
            <div style={{ background: '#fff', borderRadius: 16, overflow: 'hidden', boxShadow: '0 25px 50px rgba(0,0,0,0.1)', border: '1px solid var(--line)', height: 400 }}>
              <div style={{ background: '#f8f9fa', padding: '12px 16px', display: 'flex', gap: 8, borderBottom: '1px solid var(--line)' }}>
                <div style={{ width: 12, height: 12, borderRadius: '50%', background: '#ff5f56' }} />
                <div style={{ width: 12, height: 12, borderRadius: '50%', background: '#ffbd2e' }} />
                <div style={{ width: 12, height: 12, borderRadius: '50%', background: '#27c93f' }} />
              </div>
              <div style={{ display: 'flex', height: 'calc(100% - 41px)' }}>
                <div style={{ width: 120, borderRight: '1px solid var(--line)', padding: 16, display: 'flex', flexDirection: 'column', gap: 12 }}>
                  {p.mock.side.map((item, i) => (
                    <div key={i} style={{ fontSize: 13, color: i === 1 ? 'var(--pc)' : 'var(--mut)', fontWeight: i === 1 ? 600 : 400 }}>{item}</div>
                  ))}
                </div>
                <div style={{ flex: 1, padding: 24, background: `rgba(var(--prgb), 0.03)` }}>
                  <div style={{ width: '40%', height: 24, background: 'rgba(0,0,0,0.05)', borderRadius: 4, marginBottom: 24 }} />
                  <div style={{ display: 'flex', gap: 16, marginBottom: 24 }}>
                     <div style={{ flex: 1, height: 80, background: '#fff', borderRadius: 8, border: '1px solid var(--line)' }} />
                     <div style={{ flex: 1, height: 80, background: '#fff', borderRadius: 8, border: '1px solid var(--line)' }} />
                  </div>
                  <div style={{ height: 140, background: '#fff', borderRadius: 8, border: '1px solid var(--line)' }} />
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Detailed Features (Zig-Zag) */}
        <div style={{ marginTop: 120 }}>
          <h2 style={{ fontSize: '2.5rem', marginBottom: 60, textAlign: 'center' }}>Todo lo que incluye</h2>
          
          <div style={{ display: 'flex', flexDirection: 'column', gap: 80 }}>
            {p.detailedFeats.map((feat, i) => (
              <div key={i} className="zig-zag-row reveal" style={{ display: 'flex', flexDirection: i % 2 === 0 ? 'row' : 'row-reverse', gap: 48, alignItems: 'center' }}>
                <div style={{ flex: 1 }}>
                  <h3 style={{ fontSize: '1.8rem', marginBottom: 16, color: 'var(--ink)' }}>{feat.t}</h3>
                  <p style={{ color: 'var(--mut)', fontSize: '1.1rem', lineHeight: 1.6 }}>{feat.d}</p>
                </div>
                <div style={{ flex: 1 }}>
                  <img src={feat.img} alt={feat.t} style={{ width: '100%', borderRadius: 24, boxShadow: '0 20px 40px rgba(0,0,0,0.1)', objectFit: 'cover', aspectRatio: '4/3' }} />
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Pricing */}
        <div style={{ marginTop: 120, textAlign: 'center' }}>
          <h2 style={{ fontSize: '2.5rem', marginBottom: 40 }}>Un precio simple, todo incluido.</h2>
          
          <div className="glass reveal" style={{ maxWidth: 800, margin: '0 auto', borderRadius: 24, padding: 40, textAlign: 'left', display: 'flex', gap: 40, alignItems: 'center' }}>
            <div style={{ flex: 1, borderRight: '1px solid var(--line)', paddingRight: 40 }}>
              <div style={{ fontSize: '4rem', fontFamily: 'var(--font-heading)', color: 'var(--ink)', lineHeight: 1 }}>
                ${p.monthly}
              </div>
              <div style={{ color: 'var(--mut)', marginTop: 8 }}>MXN / mes</div>
            </div>
            <div style={{ flex: 1 }}>
              <ul style={{ display: 'flex', flexDirection: 'column', gap: 12, marginBottom: 24 }}>
                {['Módulos completos', 'Usuarios y sucursales ilimitadas', 'Soporte técnico', 'Sin plazos forzosos'].map((item, i) => (
                  <li key={i} style={{ display: 'flex', alignItems: 'center', gap: 8 }}><span style={{ color: 'var(--ok)' }}>{ic('check', 16)}</span> {item}</li>
                ))}
              </ul>
              <Button variant="dark" style={{ width: '100%', justifyContent: 'center' }} onClick={() => setShowSubModal(true)}>
                Suscribirme ahora
              </Button>
            </div>
          </div>
        </div>

        {/* Next Product Banner */}
        <div style={{ marginTop: 120 }}>
          <div onClick={() => { if(nextP.enabled) navigate(`/producto/${nextP.id}`); else addToast('Próximamente', 'warn'); }} className="glass" style={{ padding: 40, borderRadius: 24, display: 'flex', justifyContent: 'space-between', alignItems: 'center', cursor: 'pointer', transition: 'all 0.3s' }}>
            <div>
              <div style={{ color: 'var(--mut)', fontSize: 14, marginBottom: 8 }}>Siguiente producto</div>
              <div style={{ fontSize: 24, fontWeight: 700, color: nextP.color }}>{nextP.name}</div>
            </div>
            <div style={{ color: nextP.color }}>{ic('arrowR', 32)}</div>
          </div>
        </div>
      </div>

      <Modal isOpen={showSubModal} onClose={() => setShowSubModal(false)} title={`Suscribirse a ${p.name}`}>
        <form onSubmit={e => { e.preventDefault(); addToast(`¡Suscripción a ${p.name} activada!`, 'success'); setShowSubModal(false); navigate('/cuenta'); }} style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
           <p style={{ color: 'var(--mut)' }}>Plan mensual — ${p.monthly} MXN/mes</p>
           <input required type="email" placeholder="Tu correo electrónico" style={{ padding: 12, borderRadius: 8, border: 'none', background: 'rgba(255,255,255,0.1)', color: '#fff' }} />
           <Button variant="blue" type="submit" style={{ justifyContent: 'center' }}>Continuar al pago</Button>
        </form>
      </Modal>

      <style>{`
        @keyframes float { 0% { transform: translateY(0px); } 100% { transform: translateY(-20px); } }
        @media (max-width: 768px) {
          .zig-zag-row { flex-direction: column !important; text-align: center; }
          .zig-zag-row > div { width: 100%; }
        }
      `}</style>
    </div>
  );
};
</file>

<file path="src/App.css">
.counter {
  font-size: 16px;
  padding: 5px 10px;
  border-radius: 5px;
  color: var(--accent);
  background: var(--accent-bg);
  border: 2px solid transparent;
  transition: border-color 0.3s;
  margin-bottom: 24px;

  &:hover {
    border-color: var(--accent-border);
  }
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
}

.hero {
  position: relative;

  .base,
  .framework,
  .vite {
    inset-inline: 0;
    margin: 0 auto;
  }

  .base {
    width: 170px;
    position: relative;
    z-index: 0;
  }

  .framework,
  .vite {
    position: absolute;
  }

  .framework {
    z-index: 1;
    top: 34px;
    height: 28px;
    transform: perspective(2000px) rotateZ(300deg) rotateX(44deg) rotateY(39deg)
      scale(1.4);
  }

  .vite {
    z-index: 0;
    top: 107px;
    height: 26px;
    width: auto;
    transform: perspective(2000px) rotateZ(300deg) rotateX(40deg) rotateY(39deg)
      scale(0.8);
  }
}

#center {
  display: flex;
  flex-direction: column;
  gap: 25px;
  place-content: center;
  place-items: center;
  flex-grow: 1;

  @media (max-width: 1024px) {
    padding: 32px 20px 24px;
    gap: 18px;
  }
}

#next-steps {
  display: flex;
  border-top: 1px solid var(--border);
  text-align: left;

  & > div {
    flex: 1 1 0;
    padding: 32px;
    @media (max-width: 1024px) {
      padding: 24px 20px;
    }
  }

  .icon {
    margin-bottom: 16px;
    width: 22px;
    height: 22px;
  }

  @media (max-width: 1024px) {
    flex-direction: column;
    text-align: center;
  }
}

#docs {
  border-right: 1px solid var(--border);

  @media (max-width: 1024px) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

#next-steps ul {
  list-style: none;
  padding: 0;
  display: flex;
  gap: 8px;
  margin: 32px 0 0;

  .logo {
    height: 18px;
  }

  a {
    color: var(--text-h);
    font-size: 16px;
    border-radius: 6px;
    background: var(--social-bg);
    display: flex;
    padding: 6px 12px;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: box-shadow 0.3s;

    &:hover {
      box-shadow: var(--shadow);
    }
    .button-icon {
      height: 18px;
      width: 18px;
    }
  }

  @media (max-width: 1024px) {
    margin-top: 20px;
    flex-wrap: wrap;
    justify-content: center;

    li {
      flex: 1 1 calc(50% - 8px);
    }

    a {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }
}

#spacer {
  height: 88px;
  border-top: 1px solid var(--border);
  @media (max-width: 1024px) {
    height: 48px;
  }
}

.ticks {
  position: relative;
  width: 100%;

  &::before,
  &::after {
    content: '';
    position: absolute;
    top: -4.5px;
    border: 5px solid transparent;
  }

  &::before {
    left: 0;
    border-left-color: var(--border);
  }
  &::after {
    right: 0;
    border-right-color: var(--border);
  }
}
