  on public.tiendas (registro_catalogo_id)
  where registro_catalogo_id is not null;

create or replace function public.puente_provisionar_tienda_catalogo(
  p_registro_catalogo_id uuid,
  p_usuario_id uuid,
  p_email_dueno text,
  p_nombre_dueno text,
  p_nombre_tienda text,
  p_pin_hash text,
  p_plan_id text,
  p_dias_prueba_gratis integer
)
returns table (
  tienda_id uuid,
  fecha_vencimiento timestamptz,
  dia_corte_ancla integer
)
language plpgsql
security definer
set search_path = public
as $$
declare
  v_tienda_id uuid;
  v_vencimiento timestamptz;
  v_dia_corte integer;
begin
  if p_registro_catalogo_id is null
    or p_usuario_id is null
    or p_dias_prueba_gratis not between 1 and 90 then
    raise exception 'Los datos de provisión de MiTienda no son válidos';
  end if;

  perform pg_advisory_xact_lock(hashtext(p_registro_catalogo_id::text));

  select t.id, t.fecha_vencimiento, t.dia_corte_ancla
  into v_tienda_id, v_vencimiento, v_dia_corte
  from public.tiendas as t
  where t.registro_catalogo_id = p_registro_catalogo_id
  for update;

  if found then
    return query select v_tienda_id, v_vencimiento, v_dia_corte;
    return;
  end if;

  select provisioned.tienda_id, provisioned.fecha_vencimiento, provisioned.dia_corte_ancla
  into v_tienda_id, v_vencimiento, v_dia_corte
  from public.puente_provisionar_tienda(
    p_usuario_id,
    p_email_dueno,
    p_nombre_dueno,
    p_nombre_tienda,
    p_pin_hash,
    p_plan_id,
    0,
    p_dias_prueba_gratis
  ) as provisioned;

  update public.tiendas
  set registro_catalogo_id = p_registro_catalogo_id
  where id = v_tienda_id;

  return query select v_tienda_id, v_vencimiento, v_dia_corte;
end;
$$;

revoke all on function public.puente_provisionar_tienda_catalogo(uuid, uuid, text, text, text, text, text, integer)
  from public, anon, authenticated;
grant execute on function public.puente_provisionar_tienda_catalogo(uuid, uuid, text, text, text, text, text, integer)
  to service_role;
</file>

