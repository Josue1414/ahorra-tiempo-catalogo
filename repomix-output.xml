create schema if not exists extensions;
create extension if not exists pgcrypto with schema extensions;

create table public.signup_codes (
  code_hash text primary key check (code_hash ~ '^[0-9a-f]{64}$'),
  created_at timestamptz not null default pg_catalog.now(),
  used_at timestamptz,
  used_by uuid references auth.users(id) on delete set null deferrable initially deferred,
  constraint signup_codes_used_by_requires_used_at check (used_by is null or used_at is not null)
);

create table public.subscription_registrations (
  user_id uuid primary key references auth.users(id) on delete cascade deferrable initially deferred,
  product_id text not null check (product_id = 'stockia'),
  plan_code text not null check (plan_code in ('BASICO', 'ESTANDAR', 'PLUS')),
  duration_months smallint not null check (duration_months in (1, 3, 6, 12)),
  amount_due numeric(10, 2) not null check (amount_due >= 0),
  currency text not null default 'MXN' check (currency = 'MXN'),
  full_name text not null check (char_length(pg_catalog.btrim(full_name)) between 2 and 120),
  store_name text not null check (char_length(pg_catalog.btrim(store_name)) between 2 and 120),
  status text not null default 'payment_pending' check (status = 'payment_pending'),
  created_at timestamptz not null default pg_catalog.now()
);

alter table public.signup_codes enable row level security;
alter table public.subscription_registrations enable row level security;

revoke all on table public.signup_codes from public, anon, authenticated;
revoke all on table public.subscription_registrations from public, anon, authenticated;

create or replace function public.consume_signup_code_and_create_registration()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_metadata jsonb := coalesce(new.raw_user_meta_data, '{}'::jsonb);
  v_signup_code text := upper(pg_catalog.btrim(coalesce(v_metadata ->> 'signup_code', '')));
  v_product_id text := pg_catalog.lower(pg_catalog.btrim(coalesce(v_metadata ->> 'product_id', '')));
  v_plan_code text := pg_catalog.upper(pg_catalog.btrim(coalesce(v_metadata ->> 'plan_code', '')));
  v_duration_months smallint;
  v_amount_due numeric(10, 2);
  v_full_name text := pg_catalog.btrim(coalesce(v_metadata ->> 'full_name', ''));
  v_store_name text := pg_catalog.btrim(coalesce(v_metadata ->> 'store_name', ''));
  v_code_hash text;
begin
  if v_product_id = '' and v_signup_code = '' then
    return new;
  end if;

  if v_signup_code = '' then
    raise exception 'signup_code_required';
  end if;

  if v_product_id <> 'stockia' then
    raise exception 'invalid_signup_product';
  end if;

  if v_plan_code not in ('BASICO', 'ESTANDAR', 'PLUS') then
    raise exception 'invalid_signup_plan';
  end if;

  if coalesce(v_metadata ->> 'duration_months', '') not in ('1', '3', '6', '12') then
    raise exception 'invalid_signup_duration';
  end if;
  v_duration_months := (v_metadata ->> 'duration_months')::smallint;

  if char_length(v_full_name) not between 2 and 120
    or char_length(v_store_name) not between 2 and 120 then
    raise exception 'invalid_signup_profile';
  end if;

  v_amount_due := case v_plan_code
    when 'BASICO' then case v_duration_months when 1 then 300 when 3 then 875 when 6 then 1750 when 12 then 3450 end
    when 'ESTANDAR' then case v_duration_months when 1 then 400 when 3 then 1170 when 6 then 2340 when 12 then 4600 end
    when 'PLUS' then case v_duration_months when 1 then 500 when 3 then 1450 when 6 then 2900 when 12 then 5700 end
  end;

  v_code_hash := pg_catalog.encode(extensions.digest(v_signup_code, 'sha256'), 'hex');

  update public.signup_codes
  set used_at = pg_catalog.now(),
      used_by = new.id
  where code_hash = v_code_hash
    and used_at is null;

  if not found then
    raise exception 'signup_code_invalid_or_used';
  end if;

  insert into public.subscription_registrations (
    user_id,
    product_id,
    plan_code,
    duration_months,
    amount_due,
    full_name,
    store_name
  ) values (
    new.id,
    v_product_id,
    v_plan_code,
    v_duration_months,
    v_amount_due,
    v_full_name,
    v_store_name
  );

  new.raw_user_meta_data := v_metadata - 'signup_code' - 'registration_status';
  new.raw_app_meta_data := coalesce(new.raw_app_meta_data, '{}'::jsonb) || pg_catalog.jsonb_build_object(
    'registration_status', 'payment_pending',
    'product_id', v_product_id,
    'plan_code', v_plan_code,
    'duration_months', v_duration_months
  );

  return new;
end;
$$;

revoke all on function public.consume_signup_code_and_create_registration() from public, anon, authenticated;

create trigger on_auth_user_created_consume_signup_code
before insert on auth.users
for each row
execute function public.consume_signup_code_and_create_registration();

